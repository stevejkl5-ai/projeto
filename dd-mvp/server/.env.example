# Porta do servidor
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Portal da Transparência (CGU) - gratuito, requer cadastro
# Cadastro: https://api.portaldatransparencia.gov.br/swagger-ui.html
# ------------------------------------------------------------------
PORTAL_TRANSPARENCIA_API_KEY=

# ------------------------------------------------------------------
# NewsAPI.org (opcional) - usado no connector de notícias
# Cadastro: https://newsapi.org/register
# Sem key, o connector de notícias roda em modo MOCK.
# ------------------------------------------------------------------
NEWS_API_KEY=

# ------------------------------------------------------------------
# Reservado para integrações comerciais futuras (não usadas no MVP)
# ------------------------------------------------------------------
SERASA_API_KEY=
BANCO_DO_BRASIL_API_KEY=
CAIXA_API_KEY=
